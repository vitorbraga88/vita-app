{
  "configVersion": "v3",
  "app": {
    "appId": 27391,
    "appName": "VITA",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "VITA",
    "description": "Treino do dia do VITA no pulso, offline primeiro"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.alarm",
    "device:os.notification",
    "device:os.bg_service"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "4.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "trex3": {
      "module": {
        "page": {
          "pages": ["page/hoje", "page/exercicio"]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        },
        "app-service": {
          "services": ["app-service/lembrete"]
        }
      },
      "platforms": [
        { "name": "T-Rex 3 (China)", "deviceSource": 8716544 },
        { "name": "T-Rex 3", "deviceSource": 8716545 },
        { "name": "T-Rex 3", "deviceSource": 8716547 }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "pt-BR": {
      "appName": "VITA"
    },
    "en-US": {
      "appName": "VITA"
    }
  },
  "defaultLanguage": "pt-BR",
  "debug": false
}
